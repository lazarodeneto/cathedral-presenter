{
  "name": "church-presenter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first church presentation operator workspace",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop": "node desktop/launch.cjs",
    "antivirus:update": "node desktop/update-antivirus.cjs",
    "desktop:build": "npm run build && node desktop/build.cjs",
    "desktop:package": "npm run desktop:build && node desktop/package.cjs",
    "desktop:package:mac": "npm run desktop:build && node desktop/package.cjs --mac",
    "desktop:package:win": "npm run desktop:build && node desktop/package.cjs --win"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "better-auth": "^1.7.18",
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.62.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "main": "desktop/main.cjs",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
